{
  "name": "tech-sales-trail",
  "version": "2.1.0",
  "private": true,
  "description": "Survive one quarter of enterprise tech sales. A single-file browser game.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "release": "node scripts/build.mjs --release",
    "check:stale": "node scripts/build.mjs --check",
    "fonts": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "test:offline": "node test/e2e/offline.cjs",
    "test:firstday": "node scripts/build.mjs && node test/e2e/firstday.cjs",
    "test:resilience": "node scripts/build.mjs --test && node test/e2e/resilience.cjs dist-test/index.html",
    "test:phone": "node scripts/build.mjs --test && node test/e2e/phone.cjs dist-test/index.html",
    "parity:selftest": "node test/parity/selftest.cjs",
    "test:engine": "node scripts/unit.mjs engine test/engine",
    "test:audio": "node scripts/unit.mjs audio test/audio",
    "test:release": "node scripts/build.mjs && node test/e2e/release.cjs dist/index.html",
    "test:confirm": "node scripts/build.mjs && node test/e2e/confirm.cjs dist/index.html",
    "test:matrix": "node scripts/build.mjs && node test/e2e/matrix.cjs dist/index.html",
    "copy:coverage": "node scripts/copy-coverage.mjs --verbose",
    "integrity:diff": "node test/engine/tools/integrity-diff.mjs",
    "sim": "node test/sim/run.mjs",
    "sim:smoke": "node test/sim/smoke.mjs",
    "sim:baseline": "node test/sim/check-baseline.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:release": "node scripts/verify.mjs --release",
    "test:saves": "node scripts/verify.mjs --only build-test,saves --verbose",
    "test:layout": "node scripts/verify.mjs --only build-test,layout --verbose",
    "test:keyboard": "node scripts/verify.mjs --only build-test,keyboard --verbose",
    "test:selftest": "node scripts/build.mjs --test && node test/lint-fixtures/selftest.mjs && node test/saves/run.cjs --selftest && node test/e2e/layout.cjs dist-test/index.html --selftest && node test/e2e/keyboard.cjs dist-test/index.html --selftest",
    "saves:generate": "node test/saves/generate.cjs",
    "saves:check": "node test/saves/generate.cjs --check",
    "lint:rng": "node scripts/lint-rng.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:css": "node scripts/lint-css.mjs",
    "test:copy": "node test/copy/check.cjs && node test/copy/render.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "7.28.4",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@fontsource-variable/inter": "5.3.0",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "lucide-static": "1.70.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "subset-font": "2.9.0"
  }
}
