{
  "name": "tech-sales-trail",
  "version": "2.0.0",
  "private": true,
  "description": "Survive one quarter of enterprise tech sales. A single-file browser game.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --release",
    "check:stale": "node scripts/build.mjs --check",
    "fonts": "node scripts/fonts.mjs",
    "fonts:check": "node scripts/fonts.mjs --check",
    "test:offline": "node test/e2e/offline.cjs",
    "parity": "node scripts/build.mjs && node test/parity/run.cjs --b dist/index.html --workers 2",
    "parity:full": "node scripts/build.mjs && node test/parity/run.cjs --b dist/index.html --workers 2 --full",
    "parity:sound": "node scripts/build.mjs && node test/parity/run.cjs --b dist/index.html --workers 2 --sound",
    "parity:selftest": "node test/parity/selftest.cjs",
    "verify": "node scripts/verify.mjs",
    "test:saves": "node scripts/verify.mjs --only build,saves --verbose",
    "test:layout": "node scripts/verify.mjs --only build,layout --verbose",
    "test:keyboard": "node scripts/verify.mjs --only build,keyboard --verbose",
    "test:selftest": "node scripts/build.mjs && node test/lint-fixtures/selftest.mjs && node test/saves/run.cjs --selftest && node test/e2e/layout.cjs dist/index.html --selftest && node test/e2e/keyboard.cjs dist/index.html --selftest",
    "saves:generate": "node test/saves/generate.cjs",
    "saves:check": "node test/saves/generate.cjs --check",
    "lint:rng": "node scripts/lint-rng.mjs",
    "lint:copy": "node scripts/lint-copy.mjs",
    "lint:css": "node scripts/lint-css.mjs"
  },
  "devDependencies": {
    "@babel/standalone": "7.28.4",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@fontsource-variable/inter": "5.3.0",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "lucide-static": "1.70.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "subset-font": "2.9.0"
  }
}
